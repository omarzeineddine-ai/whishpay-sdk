{
  "name": "whishpay-sdk",
  "version": "0.1.1",
  "description": "Unofficial TypeScript SDK for the Whish Pay API (v2). Not affiliated with or endorsed by Whish Money.",
  "license": "MIT",
  "author": "Omar Zeineddine",
  "homepage": "https://omarzeineddine-ai.github.io/whishpay-sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omarzeineddine-ai/whishpay-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/omarzeineddine-ai/whishpay-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "whish",
    "whish-pay",
    "whish-money",
    "payments",
    "lebanon",
    "sdk",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile node16",
    "spike": "node --env-file=.env spike/spike.mjs",
    "smoke": "node --env-file=.env scripts/sandbox-smoke.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
